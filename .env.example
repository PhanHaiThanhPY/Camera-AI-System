PORT=4000
DATABASE_URL=postgresql://camera_ai:camera_ai@localhost:5433/camera_ai
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Chế độ demo ---
# true = API trả về dữ liệu mẫu dựng sẵn (xem apps/api/src/gate/demo-data.ts), không đụng tới Postgres —
# dùng khi demo/giới thiệu mà chưa nối camera/cân/DB thật (không cần DATABASE_URL khi bật).
# false (mặc định) = chạy luồng thật, đọc/ghi Postgres như bình thường.
DEMO_MODE=false

# --- Lớp python/ (nhận diện biển số, phân loại xe/vật liệu) — xem python/README.md ---
# Bắt buộc ở mode cân-trước-chụp-sau: pipeline.py polling đây để biết lúc nào trạm cân xong, cần chụp.
GATE_API_URL=http://localhost:4000/api
# Trạm cân mà camera này đang theo dõi (nhiều camera cùng trạm thì đặt giống nhau — xem CAPTURE_EXPECTED_SHOTS).
CAPTURE_SCALE_ID=SCALE-01
# Mỗi bao nhiêu giây hỏi apps/api xem trạm cân vừa cân xong chưa khi chưa có tín hiệu — rẻ, không cần nhỏ.
CAPTURE_POLL_SECONDS=1
# Laplacian variance dưới ngưỡng này coi là ảnh mờ (dù OCR đọc được chữ) — chỉnh theo thực tế camera.
CAPTURE_BLUR_MIN_VARIANCE=60
LPR_MODEL_PATH=python/models/license-plate-detector.pt
LPR_IMGSZ=1280
LPR_CONFIDENCE=0.3
LPR_MIN_OCR=0.5
# Biển số hợp lệ (mặc định biển Việt Nam: 2 số + 1–2 chữ + 4–6 số)
# LPR_PLATE_REGEX=^\d{2}[A-Z]{1,2}\d{4,6}$

# --- Ảnh bằng chứng (MinIO) — python/detect chụp frame xe/biển số lúc nhận diện rồi upload lên đây ---
# Để trống MINIO_ENDPOINT = pipeline vẫn chạy được, chỉ bỏ qua bước lưu ảnh (khác GATE_API_URL ở trên — cái đó bắt buộc).
# Local dev: docker compose up -d minio minio-init (xem docker-compose.yml), endpoint mặc định dưới đây khớp sẵn.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=camera_ai
MINIO_SECRET_KEY=camera_ai_minio
MINIO_BUCKET=camera-captures
MINIO_SECURE=false
# Đổi khi deploy (vd https://minio.cong-ty.vn) để link ảnh trả về đúng domain công khai thay vì MINIO_ENDPOINT nội bộ
# MINIO_PUBLIC_URL=http://localhost:9000
# Giá trị MINIO_ROOT_USER/MINIO_ROOT_PASSWORD cho chính container MinIO (docker-compose.yml) — production nên
# đổi khỏi mặc định và tạo access key riêng (không dùng root) cho MINIO_ACCESS_KEY/MINIO_SECRET_KEY ở trên.
MINIO_ROOT_USER=camera_ai
MINIO_ROOT_PASSWORD=camera_ai_minio
# Model phát hiện xe (COCO). Trống/không có file = ước lượng khung xe từ biển số
VEHICLE_DET_MODEL_PATH=python/models/yolov8n.pt
VEHICLE_WIDTH_PLATE_RATIO=5
LOAD_REGION_TOP_FRACTION=0.5
# Model phân loại loại đá (tuỳ chọn; tên class trùng mã trong gate.catalog.ts)
MATERIAL_MODEL_PATH=
# Khi không có model riêng: CLIP zero-shot ước lượng loại đá (tắt bằng false)
MATERIAL_ZERO_SHOT=false
MATERIAL_MIN_CONF=0.5
LPR_MIN_DETECTOR_CONF=0.4

# --- Kiểm soát xe & cân ---
GATE_MATCH_WINDOW_SECONDS=180
GATE_MIN_OCR_CONFIDENCE=0.6
GATE_EMPTY_NET_KG=500
GATE_SECOND_WEIGH_WINDOW_SECONDS=14400
# Cân giả lập: mỗi lần chụp được biển số thì random cân. Đặt false khi đã nối trạm cân thật
# Chỉ bật true khi chạy demo; production nên để false hoặc bỏ trống
WEIGHBRIDGE_MOCK_RANDOM=false
# Đặt để yêu cầu header X-Weighbridge-Key từ hệ thống cân
WEIGHBRIDGE_API_KEY=

# --- Telegram ---
# Vì lý do bảo mật, token/chat id CHỈ đặt ở đây — giao diện không còn chỗ nhập/lưu/hiện token
# (không đi qua trình duyệt, không lưu trong Postgres). Lấy token từ @BotFather; lấy Chat ID bằng
# cách add bot vào nhóm, gửi 1 tin nhắn, rồi bấm "Tìm nhóm" ở menu Telegram trên dashboard.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Múi giờ để chia ngày và hiển thị giờ trong báo cáo
REPORT_TIMEZONE=Asia/Ho_Chi_Minh

# --- Trợ lý AI trong Telegram (chat hỏi đáp tự do về dữ liệu hệ thống) ---
# Lấy tại https://platform.deepseek.com — để trống thì bot vẫn gửi báo cáo bình thường,
# chỉ riêng phần hỏi đáp tự do sẽ báo "chưa cấu hình" khi admin nhắn tin cho bot.
# Cũng chỉ đặt qua biến môi trường này — không có nơi nhập key qua giao diện.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Giới hạn những chat được phép hỏi trợ lý, cách nhau bằng dấu phẩy. Để trống = cho phép mọi chat đã nhắn tin cho bot.
TELEGRAM_ASSISTANT_ALLOWED_CHAT_IDS=

# --- Cân-trước-chụp-sau: cân xong mới yêu cầu camera chụp, chụp xong mới nhận diện ---
# Số camera cần chụp mỗi lần cân (mỗi camera là 1 tiến trình python/detect/pipeline.py riêng)
CAPTURE_EXPECTED_SHOTS=4
# Chờ tối đa bấy nhiêu giây để đủ ảnh trước khi chốt; thiếu ảnh dùng được -> trạng thái CAPTURE_FAILED
CAPTURE_TIMEOUT_SECONDS=20
