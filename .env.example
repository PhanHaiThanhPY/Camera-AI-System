PORT=4000
STORAGE_ROOT=../../storage
# Python của worker. Bỏ trống để tự dùng .venv ở gốc repo (nếu có), nếu không dùng python3.
# PYTHON_BIN=

# --- Worker nhận diện (đọc biển số thật từ video) ---
LPR_MODEL_PATH=models/license-plate-detector.pt
LPR_IMGSZ=1280
LPR_CONFIDENCE=0.3
# Cứ mỗi N giây video chạy detector một lần; nhỏ hơn thì bắt được xe nhanh hơn nhưng chậm hơn
LPR_SAMPLE_SECONDS=0.5
LPR_MIN_OCR=0.5
LPR_TRACK_TIMEOUT=1.5
# Biển số hợp lệ (mặc định biển Việt Nam: 2 số + 1–2 chữ + 4–6 số)
# LPR_PLATE_REGEX=^\d{2}[A-Z]{1,2}\d{4,6}$
# Model phát hiện xe (COCO). Trống/không có file = ước lượng khung xe từ biển số
VEHICLE_DET_MODEL_PATH=models/yolov8n.pt
VEHICLE_WIDTH_PLATE_RATIO=5
LOAD_REGION_TOP_FRACTION=0.5
# Model phân loại loại đá (tuỳ chọn, chạy trên ảnh vùng hàng; tên class trùng mã trong gate.catalog.ts)
MATERIAL_MODEL_PATH=

# --- Kiểm soát xe & cân ---
GATE_MATCH_WINDOW_SECONDS=180
GATE_MIN_OCR_CONFIDENCE=0.6
GATE_EMPTY_NET_KG=500
GATE_SECOND_WEIGH_WINDOW_SECONDS=14400
# Cân giả lập: mỗi lần chụp được biển số thì random cân. Đặt false khi đã nối trạm cân thật
WEIGHBRIDGE_MOCK_RANDOM=true
# Đặt để yêu cầu header X-Weighbridge-Key từ hệ thống cân
WEIGHBRIDGE_API_KEY=
