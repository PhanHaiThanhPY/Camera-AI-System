PORT=4000
DATABASE_URL=postgresql://camera_ai:camera_ai@localhost:5433/camera_ai
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Lớp python/ (nhận diện biển số, phân loại xe/vật liệu) — xem python/README.md ---
LPR_MODEL_PATH=python/models/license-plate-detector.pt
LPR_IMGSZ=1280
LPR_CONFIDENCE=0.3
# Cứ mỗi N giây video chạy detector một lần; nhỏ hơn thì bắt được xe nhanh hơn nhưng chậm hơn
LPR_SAMPLE_SECONDS=0.5
LPR_MIN_OCR=0.5
LPR_TRACK_TIMEOUT=1.5
# Biển số hợp lệ (mặc định biển Việt Nam: 2 số + 1–2 chữ + 4–6 số)
# LPR_PLATE_REGEX=^\d{2}[A-Z]{1,2}\d{4,6}$
# Model phát hiện xe (COCO). Trống/không có file = ước lượng khung xe từ biển số
VEHICLE_DET_MODEL_PATH=python/models/yolov8n.pt
VEHICLE_WIDTH_PLATE_RATIO=5
LOAD_REGION_TOP_FRACTION=0.5
# Model phân loại loại đá (tuỳ chọn; tên class trùng mã trong gate.catalog.ts)
MATERIAL_MODEL_PATH=
# Khi không có model riêng: CLIP zero-shot ước lượng loại đá (tắt bằng false)
MATERIAL_ZERO_SHOT=false
MATERIAL_MIN_CONF=0.5
LPR_MIN_DETECTOR_CONF=0.4

# --- Kiểm soát xe & cân ---
GATE_MATCH_WINDOW_SECONDS=180
GATE_MIN_OCR_CONFIDENCE=0.6
GATE_EMPTY_NET_KG=500
GATE_SECOND_WEIGH_WINDOW_SECONDS=14400
# Cân giả lập: mỗi lần chụp được biển số thì random cân. Đặt false khi đã nối trạm cân thật
# Chỉ bật true khi chạy demo; production nên để false hoặc bỏ trống
WEIGHBRIDGE_MOCK_RANDOM=false
# Đặt để yêu cầu header X-Weighbridge-Key từ hệ thống cân
WEIGHBRIDGE_API_KEY=

# --- Telegram (cài trên giao diện, menu Telegram; hoặc đặt ở đây) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Múi giờ để chia ngày và hiển thị giờ trong báo cáo
REPORT_TIMEZONE=Asia/Ho_Chi_Minh

# --- Trợ lý AI trong Telegram (chat hỏi đáp tự do về dữ liệu hệ thống) ---
# Lấy tại https://console.anthropic.com — để trống thì bot vẫn gửi báo cáo bình thường,
# chỉ riêng phần hỏi đáp tự do sẽ báo "chưa cấu hình" khi admin nhắn tin cho bot.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Giới hạn những chat được phép hỏi trợ lý, cách nhau bằng dấu phẩy. Để trống = cho phép mọi chat đã nhắn tin cho bot.
TELEGRAM_ASSISTANT_ALLOWED_CHAT_IDS=
